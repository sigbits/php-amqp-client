[req]
default_bits = 2048
distinguished_name = distinguished_name
prompt = no
req_extensions = request_extensions

[distinguished_name]
CN = rabbitmq-tls.sigbits.test

[request_extensions]
subjectAltName = @subject_alt_names

[subject_alt_names]
DNS.1 = rabbitmq-tls.sigbits.test
DNS.2 = rabbitmq-tls
